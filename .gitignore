# Ignore everything
*

# Allow ONLY direct subdirectories (1 level deep) — stops recursive traversal
!/*/
# Root-level files to keep
!docker-compose.yml
!docker-compose.yaml
!*.sh
!.gitignore
!README.md

# 1-folder-deep files to keep
!/*/docker-compose.yml
!/*/docker-compose.yaml
!/*/*.sh
!/*/README.md
!/*/.env.example

# CI and local secret scanning (still default-deny everywhere else)
!.github/
!.github/**
!.pre-commit-config.yaml

# Explicit exclusions (override the README.md unignore above)
/bfbackups/*
